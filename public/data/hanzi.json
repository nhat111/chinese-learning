 "version": 1,
 "items": [
  {"id": "hz-001", "group": "number", "char": "一", "pinyin": "yī", "vi": "một", "hv": "nhất", "emoji": "1️⃣", "kind": "indicative", "note": "Một nét ngang là số một.", "words": [{"zh": "一个", "pinyin": "yí ge", "vi": "một cái"}, {"zh": "第一", "pinyin": "dì yī", "vi": "thứ nhất"}]},
  {"id": "hz-002", "group": "number", "char": "二", "pinyin": "èr", "vi": "hai", "hv": "nhị", "emoji": "2️⃣", "kind": "indicative", "note": "Hai nét ngang là số hai. Nét dưới dài hơn nét trên.", "words": [{"zh": "二月", "pinyin": "èryuè", "vi": "tháng Hai"}]},
  {"id": "hz-003", "group": "number", "char": "三", "pinyin": "sān", "vi": "ba", "hv": "tam", "emoji": "3️⃣", "kind": "indicative", "note": "Ba nét ngang là số ba.", "words": [{"zh": "三个", "pinyin": "sān ge", "vi": "ba cái"}, {"zh": "星期三", "pinyin": "xīngqīsān", "vi": "thứ Tư"}]},
  {"id": "hz-004", "group": "number", "char": "四", "pinyin": "sì", "vi": "bốn", "hv": "tứ", "emoji": "4️⃣", "words": [{"zh": "四口人", "pinyin": "sì kǒu rén", "vi": "bốn người (trong nhà)"}]},
  {"id": "hz-005", "group": "number", "char": "五", "pinyin": "wǔ", "vi": "năm", "hv": "ngũ", "emoji": "5️⃣", "words": [{"zh": "五月", "pinyin": "wǔyuè", "vi": "tháng Năm"}]},
  {"id": "hz-006", "group": "number", "char": "六", "pinyin": "liù", "vi": "sáu", "hv": "lục", "emoji": "6️⃣", "words": [{"zh": "六岁", "pinyin": "liù suì", "vi": "sáu tuổi"}]},
  {"id": "hz-007", "group": "number", "char": "七", "pinyin": "qī", "vi": "bảy", "hv": "thất", "emoji": "7️⃣", "words": [{"zh": "七天", "pinyin": "qī tiān", "vi": "bảy ngày"}]},
  {"id": "hz-008", "group": "number", "char": "八", "pinyin": "bā", "vi": "tám", "hv": "bát", "emoji": "8️⃣", "note": "Người Trung Quốc thích số 8 vì 八 bā nghe gần 发 fā (phát tài).", "words": [{"zh": "八点", "pinyin": "bā diǎn", "vi": "tám giờ"}]},
  {"id": "hz-009", "group": "number", "char": "九", "pinyin": "jiǔ", "vi": "chín", "hv": "cửu", "emoji": "9️⃣", "words": [{"zh": "九月", "pinyin": "jiǔyuè", "vi": "tháng Chín"}]},
  {"id": "hz-010", "group": "number", "char": "十", "pinyin": "shí", "vi": "mười", "hv": "thập", "emoji": "🔟", "kind": "indicative", "note": "Một nét ngang và một nét sổ cắt nhau.", "words": [{"zh": "十一", "pinyin": "shíyī", "vi": "mười một"}, {"zh": "二十", "pinyin": "èrshí", "vi": "hai mươi"}]},
  {"id": "hz-011", "group": "nature", "char": "日", "pinyin": "rì", "vi": "mặt trời; ngày", "hv": "nhật", "emoji": "☀️", "kind": "pictograph", "sketch": "M14 50a36 36 0 1 0 72 0a36 36 0 1 0-72 0M42 50h16", "note": "Nhìn mặt trời: tròn và sáng ở giữa. Người xưa vẽ vòng tròn có chấm giữa; bút lông khó vẽ tròn nên thành khung vuông 日, chấm thành nét ngang.", "words": [{"zh": "生日", "pinyin": "shēngrì", "vi": "sinh nhật"}, {"zh": "日本", "pinyin": "Rìběn", "vi": "Nhật Bản"}]},
  {"id": "hz-012", "group": "nature", "char": "月", "pinyin": "yuè", "vi": "mặt trăng; tháng", "hv": "nguyệt", "emoji": "🌙", "kind": "pictograph", "sketch": "M64 8C14 24 16 78 60 94C34 72 36 30 64 8ZM30 50h9", "note": "Nhìn trăng lưỡi liềm trên trời: cong như con thuyền. Vẽ vầng trăng khuyết dựng đứng, thêm nét ở giữa, viết thẳng lại thành 月.", "words": [{"zh": "月亮", "pinyin": "yuèliang", "vi": "mặt trăng"}, {"zh": "一月", "pinyin": "yīyuè", "vi": "tháng Một"}]},
  {"id": "hz-013", "group": "nature", "char": "山", "pinyin": "shān", "vi": "núi", "hv": "sơn", "emoji": "⛰️", "kind": "pictograph", "sketch": "M10 86H90M10 86L22 44L34 86M34 86L50 16L66 86M66 86L78 44L90 86", "note": "Nhìn dãy núi: ba ngọn nhấp nhô, ngọn giữa cao nhất. 山 chính là ba đỉnh núi đứng trên mặt đất.", "words": [{"zh": "爬山", "pinyin": "pá shān", "vi": "leo núi"}]},
  {"id": "hz-014", "group": "nature", "char": "水", "pinyin": "shuǐ", "vi": "nước", "hv": "thủy", "emoji": "💧", "kind": "pictograph", "sketch": "M50 10C38 30 62 44 50 60C40 74 58 84 50 92M28 22l4 10M24 52l4 10M72 22l-4 10M76 52l-4 10", "note": "Nhìn dòng suối: nước chảy ở giữa, bọt nước bắn ra hai bên. Nét móc giữa 水 là dòng chảy, các nét hai bên là bọt nước.", "words": [{"zh": "喝水", "pinyin": "hē shuǐ", "vi": "uống nước"}, {"zh": "水果", "pinyin": "shuǐguǒ", "vi": "hoa quả"}]},
  {"id": "hz-015", "group": "nature", "char": "火", "pinyin": "huǒ", "vi": "lửa", "hv": "hỏa", "emoji": "🔥", "kind": "pictograph", "sketch": "M50 12C64 32 72 50 64 72C58 88 42 88 36 72C28 50 36 32 50 12ZM22 38C14 56 18 76 32 86M78 38C86 56 82 76 68 86", "note": "Nhìn đống lửa trại: ngọn lửa ở giữa bốc lên, tia lửa bắn hai bên. Hai chấm trên 火 là tia lửa, phần 人 bên dưới là ngọn lửa.", "words": [{"zh": "火车", "pinyin": "huǒchē", "vi": "tàu hỏa"}]},
  {"id": "hz-016", "group": "nature", "char": "木", "pinyin": "mù", "vi": "cây, gỗ", "hv": "mộc", "emoji": "🌳", "kind": "pictograph", "sketch": "M50 8V92M50 40L24 16M50 40L76 16M50 68L26 90M50 68L74 90", "note": "Nhìn một cái cây: thân thẳng, cành vươn lên, rễ tỏa xuống đất. Nét sổ là thân, nét ngang là cành, hai nét xiên dưới là rễ.", "words": [{"zh": "木头", "pinyin": "mùtou", "vi": "gỗ"}]},
  {"id": "hz-017", "group": "nature", "char": "田", "pinyin": "tián", "vi": "ruộng", "hv": "điền", "emoji": "🌾", "kind": "pictograph", "sketch": "M14 14H86V86H14ZM50 14V86M14 50H86", "note": "Nhìn ruộng lúa từ trên cao: bờ ruộng chia thửa ruộng thành bốn ô vuông. 田 giống hệt như vậy.", "words": [{"zh": "田地", "pinyin": "tiándì", "vi": "ruộng đồng"}]},
  {"id": "hz-018", "group": "nature", "char": "雨", "pinyin": "yǔ", "vi": "mưa", "hv": "vũ", "emoji": "🌧️", "kind": "pictograph", "sketch": "M10 14H90M24 30v14M24 58v14M50 30v14M50 58v14M76 30v14M76 58v14M37 78v12M63 78v12", "note": "Nhìn trời mưa: bầu trời ở trên, giọt mưa rơi xuống. Nét ngang trên cùng là bầu trời, bốn chấm bên trong là giọt mưa.", "words": [{"zh": "下雨", "pinyin": "xià yǔ", "vi": "trời mưa"}]},
  {"id": "hz-019", "group": "nature", "char": "天", "pinyin": "tiān", "vi": "trời; ngày", "hv": "thiên", "emoji": "🌤️", "kind": "compound", "note": "Người 大 dang tay đứng, trên đầu thêm một nét ngang là bầu trời: 一 + 大 = 天.", "words": [{"zh": "今天", "pinyin": "jīntiān", "vi": "hôm nay"}, {"zh": "天气", "pinyin": "tiānqì", "vi": "thời tiết"}]},
  {"id": "hz-020", "group": "nature", "char": "土", "pinyin": "tǔ", "vi": "đất", "hv": "thổ", "emoji": "🟫", "kind": "pictograph", "sketch": "M10 86H90M30 86C30 64 40 48 50 42C60 48 70 64 70 86", "note": "Nhìn mặt đất: một ụ đất nhô lên trên nền phẳng. Nét ngang dưới là mặt đất, phần trên là ụ đất.", "words": [{"zh": "土豆", "pinyin": "tǔdòu", "vi": "khoai tây"}]},
  {"id": "hz-021", "group": "body", "char": "人", "pinyin": "rén", "vi": "người", "hv": "nhân", "emoji": "🚶", "kind": "pictograph", "sketch": "M58 10C56 38 46 66 22 92M56 42C68 48 76 58 82 72", "note": "Nhìn một người đi bộ từ bên cạnh: người hơi cúi, chân bước tới. Hai nét của 人 là hai chân đang bước.", "words": [{"zh": "中国人", "pinyin": "Zhōngguó rén", "vi": "người Trung Quốc"}, {"zh": "越南人", "pinyin": "Yuènán rén", "vi": "người Việt Nam"}]},
  {"id": "hz-022", "group": "body", "char": "口", "pinyin": "kǒu", "vi": "miệng", "hv": "khẩu", "emoji": "👄", "kind": "pictograph", "sketch": "M14 36C30 30 70 30 86 36C80 70 64 84 50 84C36 84 20 70 14 36ZM26 42C40 50 60 50 74 42", "note": "Nhìn cái miệng mở to khi nói \"a\": một khoang tròn. Viết vuông lại thành 口.", "words": [{"zh": "人口", "pinyin": "rénkǒu", "vi": "dân số"}, {"zh": "门口", "pinyin": "ménkǒu", "vi": "cửa ra vào"}]},
  {"id": "hz-023", "group": "body", "char": "目", "pinyin": "mù", "vi": "mắt", "hv": "mục", "emoji": "👁️", "kind": "pictograph", "sketch": "M8 50C26 22 74 22 92 50C74 78 26 78 8 50ZM38 50a12 12 0 1 0 24 0a12 12 0 1 0-24 0", "note": "Nhìn con mắt: hình bầu dục, con ngươi ở giữa. Người xưa vẽ mắt nằm ngang, sau dựng đứng lên cho gọn thành 目; hai nét ngang giữa là con ngươi.", "words": [{"zh": "目光", "pinyin": "mùguāng", "vi": "ánh mắt"}]},
  {"id": "hz-024", "group": "body", "char": "耳", "pinyin": "ěr", "vi": "tai", "hv": "nhĩ", "emoji": "👂", "kind": "pictograph", "sketch": "M38 14C68 8 86 28 82 52C78 72 62 74 58 88C54 98 38 94 40 82M44 34C60 30 68 44 58 58", "note": "Sờ vào tai mình: vành tai cong, dái tai ở dưới. 耳 là vành tai dựng đứng.", "words": [{"zh": "耳朵", "pinyin": "ěrduo", "vi": "cái tai"}]},
  {"id": "hz-025", "group": "body", "char": "手", "pinyin": "shǒu", "vi": "tay", "hv": "thủ", "emoji": "✋", "kind": "pictograph", "sketch": "M50 92V50M50 50C40 40 32 28 28 12M50 50C47 36 46 22 46 8M50 50C54 36 56 22 58 8M50 50C60 40 68 30 72 14M50 62C40 58 28 54 18 44", "note": "Xòe bàn tay ra: các ngón tay tỏa ra từ lòng bàn tay. 手 là cổ tay ở dưới, các ngón tay ở trên.", "words": [{"zh": "手机", "pinyin": "shǒujī", "vi": "điện thoại"}, {"zh": "洗手", "pinyin": "xǐ shǒu", "vi": "rửa tay"}]},
  {"id": "hz-026", "group": "body", "char": "心", "pinyin": "xīn", "vi": "trái tim", "hv": "tâm", "emoji": "❤️", "kind": "pictograph", "sketch": "M50 88C20 66 10 46 18 30C26 16 44 18 50 34C56 18 74 16 82 30C90 46 80 66 50 88ZM50 34V60", "note": "Hình trái tim trong lồng ngực. Nét cong lớn của 心 là quả tim, ba chấm là các ngăn tim.", "words": [{"zh": "开心", "pinyin": "kāixīn", "vi": "vui vẻ"}, {"zh": "小心", "pinyin": "xiǎoxīn", "vi": "cẩn thận"}]},
  {"id": "hz-027", "group": "body", "char": "女", "pinyin": "nǚ", "vi": "nữ, con gái", "hv": "nữ", "emoji": "👧", "kind": "pictograph", "sketch": "M50 10C42 30 40 50 46 66C52 80 64 86 78 88M24 34C40 46 58 48 76 40M46 66C36 74 28 82 22 92", "note": "Người phụ nữ xưa ngồi quỳ, hai tay khoanh trước ngực. Nét chéo của 女 là hai tay khoanh, phần dưới là chân đang quỳ.", "words": [{"zh": "女儿", "pinyin": "nǚ'ér", "vi": "con gái"}, {"zh": "女孩", "pinyin": "nǚhái", "vi": "bé gái"}]},
  {"id": "hz-028", "group": "body", "char": "子", "pinyin": "zǐ", "vi": "con", "hv": "tử", "emoji": "👶", "kind": "pictograph", "sketch": "M36 24a14 14 0 1 0 28 0a14 14 0 1 0-28 0M50 38V88C50 92 44 94 38 88M18 50C34 56 66 56 82 50", "note": "Nhìn em bé quấn tã: đầu to, hai tay giơ lên, chân quấn trong tã. Phần trên của 子 là đầu, nét ngang là hai tay, nét móc là thân.", "words": [{"zh": "儿子", "pinyin": "érzi", "vi": "con trai"}, {"zh": "孩子", "pinyin": "háizi", "vi": "trẻ con"}]},
  {"id": "hz-029", "group": "body", "char": "大", "pinyin": "dà", "vi": "to, lớn", "hv": "đại", "emoji": "🙆", "kind": "pictograph", "sketch": "M42 18a8 8 0 1 0 16 0a8 8 0 1 0-16 0M50 26V58M16 40H84M50 58L24 92M50 58L76 92", "note": "Đứng thẳng, dang rộng tay chân: trông thật to! 大 chính là một người đang dang tay chân.", "words": [{"zh": "大象", "pinyin": "dàxiàng", "vi": "con voi"}, {"zh": "大家", "pinyin": "dàjiā", "vi": "mọi người"}]},
  {"id": "hz-030", "group": "body", "char": "小", "pinyin": "xiǎo", "vi": "nhỏ, bé", "hv": "tiểu", "emoji": "🐜", "kind": "indicative", "note": "Ba hạt cát nhỏ xíu, một hạt giữa và hai hạt hai bên: những thứ nhỏ bé.", "words": [{"zh": "小猫", "pinyin": "xiǎomāo", "vi": "mèo con"}, {"zh": "小朋友", "pinyin": "xiǎopéngyou", "vi": "bạn nhỏ"}]},
  {"id": "hz-031", "group": "body", "char": "上", "pinyin": "shàng", "vi": "trên, lên", "hv": "thượng", "emoji": "⬆️", "kind": "indicative", "note": "Nét chỉ hướng lên phía trên đường ngang.", "words": [{"zh": "上课", "pinyin": "shàngkè", "vi": "vào học"}, {"zh": "早上", "pinyin": "zǎoshang", "vi": "buổi sáng"}]},
  {"id": "hz-032", "group": "body", "char": "下", "pinyin": "xià", "vi": "dưới, xuống", "hv": "hạ", "emoji": "⬇️", "kind": "indicative", "note": "Nét chỉ hướng xuống phía dưới đường ngang.", "words": [{"zh": "下雨", "pinyin": "xià yǔ", "vi": "trời mưa"}, {"zh": "下课", "pinyin": "xiàkè", "vi": "tan học"}]},
  {"id": "hz-033", "group": "body", "char": "中", "pinyin": "zhōng", "vi": "giữa", "hv": "trung", "emoji": "🎯", "kind": "indicative", "note": "Một nét xuyên qua chính giữa.", "words": [{"zh": "中国", "pinyin": "Zhōngguó", "vi": "Trung Quốc"}, {"zh": "中文", "pinyin": "Zhōngwén", "vi": "tiếng Trung"}]},
  {"id": "hz-034", "group": "animal", "char": "马", "pinyin": "mǎ", "vi": "con ngựa", "hv": "mã", "emoji": "🐴", "kind": "pictograph", "sketch": "M20 44C20 38 26 36 32 36H64L76 14L90 18L86 28L78 30L74 50V62H24C20 62 18 56 20 44ZM28 62V88M40 62V88M60 62V88M72 62V88M18 44C10 48 8 58 10 66M68 26L62 34M72 18L64 26", "note": "Nhìn con ngựa: đầu có bờm, bốn chân, đuôi dài. Người xưa vẽ ngựa dựng đứng; 马 ngày nay vẫn còn nét bờm ở trên và chân, đuôi ở dưới.", "words": [{"zh": "马上", "pinyin": "mǎshàng", "vi": "ngay lập tức"}]},
  {"id": "hz-035", "group": "animal", "char": "鱼", "pinyin": "yú", "vi": "con cá", "hv": "ngư", "emoji": "🐟", "kind": "pictograph", "sketch": "M50 8C64 20 66 40 60 60C57 68 53 72 50 74C47 72 43 68 40 60C34 40 36 20 50 8ZM50 74L36 92H64ZM41 38H59M41 50H59M50 30V62", "note": "Nhìn con cá dựng đầu lên: đầu nhọn ở trên, thân có vảy ở giữa (ô 田), đuôi ở dưới (nét ngang cuối).", "words": [{"zh": "金鱼", "pinyin": "jīnyú", "vi": "cá vàng"}]},
  {"id": "hz-036", "group": "animal", "char": "鸟", "pinyin": "niǎo", "vi": "con chim", "hv": "điểu", "emoji": "🐦", "kind": "pictograph", "sketch": "M28 34a12 12 0 1 1 24 0L64 30L54 40C68 46 76 58 72 70C66 82 48 84 34 76L18 88M38 32h4M38 79L42 94M50 81L54 94", "note": "Nhìn chú chim đậu nghiêng: đầu có mắt (chấm), thân và cánh, chân ở dưới (nét ngang cuối của 鸟).", "words": [{"zh": "小鸟", "pinyin": "xiǎoniǎo", "vi": "chú chim nhỏ"}]},
  {"id": "hz-037", "group": "animal", "char": "牛", "pinyin": "niú", "vi": "con bò", "hv": "ngưu", "emoji": "🐮", "kind": "pictograph", "sketch": "M18 16C20 34 32 42 50 42C68 42 80 34 82 16M50 20V92M28 62H72", "note": "Nhìn mặt con bò từ phía trước: hai sừng vểnh lên. Nét phẩy và nét ngang trên của 牛 là sừng, nét sổ là mặt bò.", "words": [{"zh": "牛奶", "pinyin": "niúnǎi", "vi": "sữa bò"}]},
  {"id": "hz-038", "group": "animal", "char": "羊", "pinyin": "yáng", "vi": "con dê, con cừu", "hv": "dương", "emoji": "🐑", "kind": "pictograph", "sketch": "M20 12C14 30 28 38 42 34M80 12C86 30 72 38 58 34M50 28V92M30 50H70M34 70H66", "note": "Nhìn mặt con dê: hai chấm trên cùng của 羊 là cặp sừng cong, các nét ngang là mặt và râu.", "words": [{"zh": "小羊", "pinyin": "xiǎoyáng", "vi": "chú cừu non"}]},
  {"id": "hz-039", "group": "common", "char": "我", "pinyin": "wǒ", "vi": "tôi, mình", "hv": "ngã", "emoji": "🙋", "words": [{"zh": "我们", "pinyin": "wǒmen", "vi": "chúng mình"}]},
